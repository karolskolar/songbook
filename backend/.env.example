# SQLite database location (absolute path recommended)
DATABASE_URL="file:./prisma/dev.db"

# HTTP server
PORT=3010
HOST=0.0.0.0

# Login (single user). Required — the server refuses to start without them.
APP_USERNAME="admin"
APP_PASSWORD="change-me"

# Secret used to sign session cookies. Required — the server refuses to start without it.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Reverse proxy address(es) allowed to set X-Forwarded-For (comma-separated IPs or subnets).
# Defaults to loopback; in production set it to the Nginx Proxy Manager IP.
# TRUST_PROXY=192.168.100.103

# Set to "production" to serve the built frontend and mark cookies Secure (HTTPS only)
# NODE_ENV=production
# FRONTEND_DIST=../frontend/dist
