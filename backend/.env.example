# SQLite database location (absolute path recommended)
DATABASE_URL="file:./prisma/dev.db"

# HTTP server
PORT=3010
HOST=0.0.0.0

# Login (single user). Required — the server refuses to start without them.
APP_USERNAME="admin"
APP_PASSWORD="change-me"

# Secret used to sign session cookies (required in production).
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Set to "production" to serve the built frontend and mark cookies Secure (HTTPS only)
# NODE_ENV=production
# FRONTEND_DIST=../frontend/dist
